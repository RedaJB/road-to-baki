# Clé API Google Gemini (analyse nutritionnelle par photo)
# Obtiens une clé gratuite : https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modèle utilisé (facultatif)
GEMINI_MODEL=gemini-3.5-flash

# ── Abonnement Pro (Stripe) ──
# Clé secrète : dashboard.stripe.com → Développeurs → Clés API (sk_test_… pour tester, sk_live_… en prod)
STRIPE_SECRET_KEY=
# Identifiants des prix (price_…) créés dans Stripe → Catalogue de produits
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
# Durée de l'essai gratuit en jours (0 = pas d'essai)
STRIPE_TRIAL_DAYS=7

# ── Restauration d'abonnement (vérification de l'e-mail) ──
# Clé de signature des codes et jetons d'accès (32 caractères minimum, garde-la secrète)
# Génère-la avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RESTORE_SECRET=
# Clé API Resend (resend.com → API Keys) pour envoyer le code à 6 chiffres
RESEND_API_KEY=
# Expéditeur, sur un domaine vérifié dans Resend (ex. Road to Baki <code@tondomaine.fr>)
RESEND_FROM=

# Adresse publique du site (liens de retour Stripe, aperçus de partage)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Code d'accès Pro du propriétaire (8 caractères minimum, plusieurs codes séparés par des virgules)
PRO_ACCESS_CODE=

# ── Appareils connectés (API Google Health, ex-API Fitbit) ──
# console.cloud.google.com → active « Google Health API » → Identifiants → ID client OAuth « Application Web »
# URI de redirection à déclarer : http://localhost:3000/api/health/google/callback (dev, ou le port utilisé) et https://<ton-domaine>/api/health/google/callback
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=
# Clé de chiffrement des connexions gardées sur les téléphones (32 caractères minimum, garde-la secrète, ne la change pas)
# Génère-la avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HEALTH_LINK_SECRET=
# Facultatif : adresse de retour fixe (sinon : <adresse du site>/api/health/google/callback)
GOOGLE_HEALTH_REDIRECT_URI=

# ── Pages légales (mentions légales, CGV, confidentialité) ──
# Nom ou raison sociale de l'éditeur
NEXT_PUBLIC_LEGAL_NAME=
# Statut et SIREN (ex. Micro-entreprise — SIREN 123 456 789)
NEXT_PUBLIC_LEGAL_STATUS=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_EMAIL=
# Directeur de la publication (par défaut : le nom ci-dessus)
NEXT_PUBLIC_LEGAL_DIRECTOR=
# Hébergeur (par défaut : Vercel Inc.)
NEXT_PUBLIC_LEGAL_HOST=
# Médiateur de la consommation (nom et coordonnées)
NEXT_PUBLIC_LEGAL_MEDIATOR=
# Date d'entrée en vigueur des CGV (ex. 5 novembre 2026)
NEXT_PUBLIC_LEGAL_SINCE=
